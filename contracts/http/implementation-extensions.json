{
  "schemas": {
    "OrganizationMembership": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "role": {
          "type": "string",
          "enum": [
            "MEMBER",
            "ADMIN"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "REVOKING",
            "CLOSED"
          ]
        },
        "revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      },
      "required": [
        "user_id",
        "role",
        "state",
        "revision"
      ],
      "additionalProperties": false
    },
    "PersonalTransferMetadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "document_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "document_title": {
          "type": "string"
        },
        "source_user_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "target_user_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "source_space_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "expected_control_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "state": {
          "type": "string",
          "enum": [
            "PENDING",
            "ACCEPTING",
            "ACCEPTED",
            "CANCELLED",
            "REJECTED",
            "EXPIRED"
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "target_space_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "target_knowledge_base_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "accept_operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{15,95}$"
        }
      },
      "required": [
        "id",
        "document_id",
        "document_title",
        "source_user_id",
        "target_user_id",
        "source_space_id",
        "expected_control_revision",
        "revision",
        "state",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "PersonalTransferPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/PersonalTransferMetadata"
          }
        },
        "next_cursor": {
          "type": "string",
          "nullable": true
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "PersonalTransferAccept": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{15,95}$"
        },
        "expected_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "target_knowledge_base_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "expected_quota_revision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      },
      "required": [
        "operation_id",
        "expected_revision",
        "target_knowledge_base_id",
        "expected_quota_revision"
      ],
      "additionalProperties": false
    }
  },
