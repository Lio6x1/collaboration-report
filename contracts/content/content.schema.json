{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collaboration.example.invalid/schemas/content-v1",
  "title": "Business content-v1 (transport atom formatting)",
  "$ref": "#/$defs/doc",
  "$defs": {
    "linkAttrs": {
      "type": "object",
      "properties": {
        "href": {
          "type": "string",
          "pattern": "^(https?://|mailto:)",
          "maxLength": 2048
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      },
      "required": [
        "href"
      ],
      "additionalProperties": false
    },
    "mark": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "strong"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "em"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "code"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "strike"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "link"
            },
            "attrs": {
              "$ref": "#/$defs/linkAttrs"
            }
          },
          "required": [
            "type",
            "attrs"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "font"
            },
            "attrs": {
              "type": "object",
              "properties": {
                "family": {
                  "enum": [
                    "SimSun",
                    "FangSong",
                    "Times New Roman",
                    "SimHei"
                  ]
                }
              },
              "required": [
                "family"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "attrs"
          ],
          "additionalProperties": false
        }
      ]
    },
    "text": {
      "type": "object",
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          },
          "minItems": 0,
          "maxItems": 6
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    "hard_break": {
      "type": "object",
      "properties": {
        "type": {
          "const": "hard_break"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "paragraph": {
      "type": "object",
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inline"
          },
          "minItems": 0,
          "maxItems": 100000
        }
      },
      "required": [
        "type",
        "attrs"
      ],
      "additionalProperties": false
    },
    "heading": {
      "type": "object",
      "properties": {
        "type": {
          "const": "heading"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            }
          },
          "required": [
            "id",
            "level"
          ],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inline"
          },
          "minItems": 0,
          "maxItems": 100000
        }
      },
      "required": [
        "type",
        "attrs"
      ],
      "additionalProperties": false
    },
    "blockquote": {
      "type": "object",
      "properties": {
        "type": {
          "const": "blockquote"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 1,
          "maxItems": 100000
        }
      },
      "required": [
        "type",
        "attrs",
        "content"
      ],
      "additionalProperties": false
    },
    "horizontal_rule": {
      "type": "object",
      "properties": {
        "type": {
          "const": "horizontal_rule"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "attrs"
      ],
      "additionalProperties": false
    },
    "code_block": {
      "type": "object",
      "properties": {
        "type": {
          "const": "code_block"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            },
            "language": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_+#.-]{0,31}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "language"
          ],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "const": "text"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000000
              }
            },
            "required": [
              "type",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100000
        }
      },
      "required": [
        "type",
        "attrs"
      ],
      "additionalProperties": false
    },
    "bullet_list": {
      "type": "object",
      "properties": {
        "type": {
          "const": "bullet_list"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/list_item"
          },
          "minItems": 1,
          "maxItems": 100000
        }
      },
      "required": [
        "type",
        "attrs",
        "content"
      ],
      "additionalProperties": false
    },
    "ordered_list": {
      "type": "object",
      "properties": {
        "type": {
          "const": "ordered_list"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            },
            "order": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          "required": [
            "id",
            "order"
          ],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/list_item"
          },
          "minItems": 1,
          "maxItems": 100000
        }
      },
      "required": [
        "type",
        "attrs",
        "content"
      ],
      "additionalProperties": false
    },
    "list_item": {
      "type": "object",
      "properties": {
        "type": {
          "const": "list_item"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/paragraph"
            }
          ],
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 1,
          "maxItems": 100000
        }
      },
      "required": [
        "type",
        "attrs",
        "content"
      ],
      "additionalProperties": false
    },
    "formula": {
      "type": "object",
      "properties": {
        "type": {
          "const": "formula"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "latex": {
              "type": "string",
              "maxLength": 100000
            },
            "atomStrong": {
              "type": "boolean"
            },
            "atomEm": {
              "type": "boolean"
            },
            "atomCode": {
              "type": "boolean"
            },
            "atomStrike": {
              "type": "boolean"
            },
            "atomLink": {
              "oneOf": [
                {
                  "$ref": "#/$defs/linkAttrs"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "latex",
            "atomStrong",
            "atomEm",
            "atomCode",
            "atomStrike",
            "atomLink"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "attrs"
      ],
      "additionalProperties": false
    },
    "formula_block": {
      "type": "object",
      "properties": {
        "type": {
          "const": "formula_block"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            },
            "latex": {
              "type": "string",
              "maxLength": 100000
            },
            "atomStrong": {
              "type": "boolean"
            },
            "atomEm": {
              "type": "boolean"
            },
            "atomCode": {
              "type": "boolean"
            },
            "atomStrike": {
              "type": "boolean"
            },
            "atomLink": {
              "oneOf": [
                {
                  "$ref": "#/$defs/linkAttrs"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "latex",
            "atomStrong",
            "atomEm",
            "atomCode",
            "atomStrike",
            "atomLink"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "attrs"
      ],
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "properties": {
        "type": {
          "const": "image"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "resourceId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "alt": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 1000
            },
            "title": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 1000
            },
            "width": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 10000
            },
            "height": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 10000
            },
            "atomStrong": {
              "type": "boolean"
            },
            "atomEm": {
              "type": "boolean"
            },
            "atomCode": {
              "type": "boolean"
            },
            "atomStrike": {
              "type": "boolean"
            },
            "atomLink": {
              "oneOf": [
                {
                  "$ref": "#/$defs/linkAttrs"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "resourceId",
            "alt",
            "title",
            "width",
            "height",
            "atomStrong",
            "atomEm",
            "atomCode",
            "atomStrike",
            "atomLink"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "attrs"
      ],
      "additionalProperties": false
    },
    "table": {
      "type": "object",
      "properties": {
        "type": {
          "const": "table"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/table_row"
          },
          "minItems": 1,
          "maxItems": 100000
        }
      },
      "required": [
        "type",
        "attrs",
        "content"
      ],
      "additionalProperties": false
    },
    "table_row": {
      "type": "object",
      "properties": {
        "type": {
          "const": "table_row"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/table_cell"
              },
              {
                "$ref": "#/$defs/table_header"
              }
            ]
          },
          "minItems": 1,
          "maxItems": 100000
        }
      },
      "required": [
        "type",
        "attrs",
        "content"
      ],
      "additionalProperties": false
    },
    "table_cell": {
      "type": "object",
      "properties": {
        "type": {
          "const": "table_cell"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            },
            "colspan": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "rowspan": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "colwidth": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  },
                  "minItems": 1,
                  "maxItems": 1000
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "colspan",
            "rowspan",
            "colwidth"
          ],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 1,
          "maxItems": 100000
        }
      },
      "required": [
        "type",
        "attrs",
        "content"
      ],
      "additionalProperties": false
    },
    "table_header": {
      "type": "object",
      "properties": {
        "type": {
          "const": "table_header"
        },
        "attrs": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            },
            "colspan": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "rowspan": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "colwidth": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  },
                  "minItems": 1,
                  "maxItems": 1000
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "colspan",
            "rowspan",
            "colwidth"
          ],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 1,
          "maxItems": 100000
        }
      },
      "required": [
        "type",
        "attrs",
        "content"
      ],
      "additionalProperties": false
    },
    "inline": {
      "oneOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/image"
        },
        {
          "$ref": "#/$defs/formula"
        },
        {
          "$ref": "#/$defs/hard_break"
        }
      ]
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/paragraph"
        },
        {
          "$ref": "#/$defs/heading"
        },
        {
          "$ref": "#/$defs/blockquote"
        },
        {
          "$ref": "#/$defs/horizontal_rule"
        },
        {
          "$ref": "#/$defs/code_block"
        },
        {
          "$ref": "#/$defs/bullet_list"
        },
        {
          "$ref": "#/$defs/ordered_list"
        },
        {
          "$ref": "#/$defs/formula_block"
        },
        {
          "$ref": "#/$defs/table"
        }
      ]
    },
    "doc": {
      "type": "object",
      "properties": {
        "type": {
          "const": "doc"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 1,
          "maxItems": 100000
        }
      },
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false
    }
  }
}